APP_NAME=Havan Study Planner API
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://havan:havan@localhost:5432/havan_study_planner
CORS_ORIGINS=http://localhost:3000
# Production: exact Vercel origin(s), comma separated, no trailing slash
DEFAULT_TIMEZONE=Africa/Addis_Ababa
AUTH_TOKEN_TTL_DAYS=30
LOG_LEVEL=INFO
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAILS=admin@example.com

# Recommended for Render Free: HTTPS provider API (free services block outbound SMTP ports).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Havan Study Planner <no-reply@your-verified-domain.com>
# Optional SMTP fallback for local development or paid hosts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=10

# Browser push reminders (generate once with: python scripts/generate_vapid_keys.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
