{
  "compilerOptions":{
    "target":"ES2017",
    "lib":["dom","dom.iterable","esnext"],
    "allowJs":false,
    "skipLibCheck":true,
    "strict":true,
    "noEmit":true,
    "esModuleInterop":true,
    "module":"esnext",
    "moduleResolution":"bundler",
    "resolveJsonModule":true,
    "isolatedModules":true,
    "jsx":"preserve",
    "incremental":true,
    "plugins":[{"name":"next"}]
  },
  "include":["frontend/next-env.d.ts","frontend/.next/types/**/*.ts","frontend/**/*.ts","frontend/**/*.tsx"],
  "exclude":["node_modules"]
}